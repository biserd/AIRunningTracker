FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; if (!readFileSync('dist/index.js','utf8').includes('20260913-stripe-diagnostics')) process.exit(1)"

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production APP_PLATFORM=cloudflare PORT=5000
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
EXPOSE 5000
CMD ["node", "dist/index.js"]
