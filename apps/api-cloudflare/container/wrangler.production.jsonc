{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aitracker-main",
  "account_id": "73d71a2bef58f7469ecb48e2b8e84c0e",
  "main": "production.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Existing production sessions passed the initial auth-only canary.
  "routes": [
    { "pattern": "aitracker.run/*", "zone_name": "aitracker.run" },
    { "pattern": "www.aitracker.run/*", "zone_name": "aitracker.run" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [{ "binding": "PUBLIC_ASSETS", "bucket_name": "aitracker-main-assets" }],
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "CLOUDFLARE_EMAIL_ACCOUNT_ID": "73d71a2bef58f7469ecb48e2b8e84c0e",
    "EMAIL_FROM": "RunAnalytics <hello@aitracker.run>",
    "APP_ROLE": "jobs",
    "HERMES_MCP_CLIENT_ID": "ra_mcp_client_L0o4CkpSbZeZ8xlI4MyQeNXh",
    "TELEGRAM_BOT_USERNAME": "hermes_3njyz3nxuousjmh2_bot",
    "ALLOWED_PRICE_IDS": "price_1SbtcfRwvWaTf8xfSEO4iKnc,price_1SbtcfRwvWaTf8xfwcVnrRf8"
  },
  "secrets": { "required": ["DATABASE_URL","JWT_SIGNING_SECRET","EMAIL_UNSUBSCRIBE_SIGNING_SECRET_V2",
    "MARKETING_LINK_SIGNING_SECRET","MCP_TOKEN_HASH_SECRET","CHANNEL_IDENTITY_HASH_SECRET",
    "COACH_BINDING_CALLBACK_SECRET","COACH_AGENT_WEBHOOK_SIGNING_SECRET_V2","COACH_AGENT_WEBHOOK_URL",
    "OPENAI_API_KEY","CLOUDFLARE_EMAIL_API_TOKEN","STRAVA_CLIENT_SECRET",
    "VITE_STRAVA_CLIENT_ID","STRIPE_SECRET_KEY","VITE_STRIPE_PUBLIC_KEY","STRAVA_SUBSCRIPTION_ID"] },
  // Promote the tested staging image by immutable digest. Update only after its staging checks pass.
  "containers": [{ "class_name":"RunAnalyticsProduction","image":"registry.cloudflare.com/73d71a2bef58f7469ecb48e2b8e84c0e/aitracker-api-staging-runanalyticsweb@sha256:a3046219ff46aa36a3e87a8c4039adf0d48594a26545d73e8d8ad81ce43b5d5a",
    "instance_type":"standard-1","max_instances":2 }],
  "durable_objects": { "bindings": [{ "name":"WEB","class_name":"RunAnalyticsProduction" }] },
  "migrations": [{ "tag":"v1","new_sqlite_classes":["RunAnalyticsProduction"] }],
  "observability": { "enabled":true,"head_sampling_rate":0.1,"redact_query_string":true }
}
