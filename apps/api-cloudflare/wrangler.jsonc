{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aitracker-api-staging",
  "account_id": "73d71a2bef58f7469ecb48e2b8e84c0e",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "secrets": { "required": ["JWT_SIGNING_SECRET"] },
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "913001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "913002", "simple": { "limit": 60, "period": 60 } }
  ],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "a75ea8f13ccd4939bb0178b798e1ffc8" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
