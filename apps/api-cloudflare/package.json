{
  "name": "aitracker-api-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --port 8792",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run",
    "deploy:staging": "npm run check && npm test && wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "wrangler": "4.131.1"
  }
}
