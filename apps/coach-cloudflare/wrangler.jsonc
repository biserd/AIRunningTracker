{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aitracker-coach-preview",
  "account_id": "73d71a2bef58f7469ecb48e2b8e84c0e",
  "main": "worker/index.ts",
  "services": [{ "binding": "BACKEND", "service": "aitracker-main" }],
  "queues": {
    "producers": [{ "binding": "WHATSAPP_QUEUE", "queue": "aitracker-coach-whatsapp" }],
    "consumers": [{
      "queue": "aitracker-coach-whatsapp",
      "max_batch_size": 1,
      "max_batch_timeout": 0,
      "max_concurrency": 10,
      "max_retries": 10,
      "retry_delay": 5
    }]
  },
  "secrets": { "required": ["OPENAI_API_KEY", "TWILIO_AUTH_TOKEN", "TWILIO_ACCOUNT_SID", "TWILIO_WHATSAPP_FROM", "TWILIO_WHATSAPP_CONTENT_SID", "WHATSAPP_GRANT_KEY"] },
  "send_email": [
    {
      "name": "REMINDER_EMAIL",
      "allowed_sender_addresses": ["reminders@aitracker.run"],
    },
  ],
  "vars": {
    "REMINDER_FROM": "reminders@aitracker.run",
    "PUBLIC_ORIGIN": "https://new.aitracker.run",
  },
  "durable_objects": {
    "bindings": [{ "name": "VOICE_LEASE", "class_name": "VoiceLease" }, { "name": "WHATSAPP_DISPATCH", "class_name": "WhatsAppDispatch" }],
  },
  "migrations": [{ "tag": "voice-v1", "new_sqlite_classes": ["VoiceLease"] }, { "tag": "whatsapp-dispatch-v1", "new_sqlite_classes": ["WhatsAppDispatch"] }],
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aitracker-coach-preview",
      "database_id": "d0ab8c6e-e650-4b9d-836e-6c8882ca89c2",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true },
  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  "routes": [{ "pattern": "new.aitracker.run", "custom_domain": true }],
}
