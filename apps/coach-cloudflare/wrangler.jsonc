{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aitracker-coach-preview",
  "account_id": "73d71a2bef58f7469ecb48e2b8e84c0e",
  "main": "worker/index.ts",
  "secrets": { "required": ["OPENAI_API_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "VOICE_LEASE", "class_name": "VoiceLease" }],
  },
  "migrations": [{ "tag": "voice-v1", "new_sqlite_classes": ["VoiceLease"] }],
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aitracker-coach-preview",
      "database_id": "d0ab8c6e-e650-4b9d-836e-6c8882ca89c2",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["0 4 * * *"] },
  "workers_dev": true,
  "routes": [{ "pattern": "new.aitracker.run", "custom_domain": true }],
}
